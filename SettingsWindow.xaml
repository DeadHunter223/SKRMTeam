<Window x:Class="SKRMTeam.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="460" Width="400"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Grid>
    <Border CornerRadius="6" Margin="10">
      <Border.Effect>
        <DropShadowEffect Color="#C0392B" BlurRadius="35" ShadowDepth="0" Opacity="0.4"/>
      </Border.Effect>
      <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
    </Border>
    <Border CornerRadius="6" Margin="10" ClipToBounds="True" BorderThickness="1">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1A0808" Offset="0"/>
          <GradientStop Color="#C0392B" Offset="0.5"/>
          <GradientStop Color="#1A0808" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="2"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#0E0A0A">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="3" Height="20" CornerRadius="2" Margin="0,0,12,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF6B5B" Offset="0"/>
                    <GradientStop Color="#C0392B" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel>
                <TextBlock Text="Настройки" FontSize="14" FontWeight="Bold" Foreground="#F0F0F0" FontFamily="Segoe UI"/>
                <TextBlock Text="Токен, оверлей и управление" FontSize="10" Foreground="#444444" FontFamily="Segoe UI"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}" CornerRadius="3">
                    <TextBlock Text="&#x2715;" FontSize="12" Foreground="#555555" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#C0392B"/>
                      <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

        <!-- Красная линия -->
        <Rectangle Grid.Row="1">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#0A0808" Offset="0"/>
              <GradientStop Color="#E74C3C" Offset="0.3"/>
              <GradientStop Color="#C0392B" Offset="0.5"/>
              <GradientStop Color="#E74C3C" Offset="0.7"/>
              <GradientStop Color="#0A0808" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- Контент -->
        <StackPanel Grid.Row="2" Margin="16,14,16,0">
          <!-- Поверх окон -->
          <Border Background="#0E0A0A" CornerRadius="4" Padding="14,12" Margin="0,0,0,10" BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush Color="#1A0A0A"/></Border.BorderBrush>
            <StackPanel Orientation="Horizontal">
              <CheckBox x:Name="TopmostCheck" IsChecked="True" VerticalAlignment="Center"
                        Margin="0,0,12,0" Checked="TopmostCheck_Changed" Unchecked="TopmostCheck_Changed">
                <CheckBox.Style>
                  <Style TargetType="CheckBox">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                          <Border Width="18" Height="18" CornerRadius="3" BorderThickness="1">
                            <Border.BorderBrush><SolidColorBrush Color="#C0392B"/></Border.BorderBrush>
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter Property="Background" Value="#C0392B"/>
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                            <TextBlock Text="&#x2713;" Foreground="White" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=CheckBox}}" Value="True">
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Border>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </CheckBox.Style>
              </CheckBox>
              <StackPanel>
                <TextBlock Text="Поверх окон (оверлей)" Foreground="#E0E0E0" FontSize="13" FontFamily="Segoe UI"/>
                <TextBlock Text="Окно будет отображаться поверх игры" Foreground="#444444" FontSize="10" FontFamily="Segoe UI"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- LZT токен -->
          <Border Background="#0E0A0A" CornerRadius="4" Padding="14,12" Margin="0,0,0,10" BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush Color="#1A0A0A"/></Border.BorderBrush>
            <StackPanel>
              <TextBlock Text="LZT Market API токен" Foreground="#E0E0E0" FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold"/>
              <TextBlock Text="Используется для определения стоимости инвентаря" Foreground="#444444" FontSize="10" FontFamily="Segoe UI" Margin="0,3,0,8"/>
              <Border BorderThickness="1" CornerRadius="3" Padding="1">
                <Border.BorderBrush><SolidColorBrush Color="#2A1010"/></Border.BorderBrush>
                <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
                <TextBox x:Name="TokenBox" Background="Transparent" Foreground="#E74C3C"
                         BorderThickness="0" Padding="8,6" FontSize="11"
                         FontFamily="Consolas" CaretBrush="#E74C3C"/>
              </Border>
              <TextBlock Foreground="#444444" FontSize="10" FontFamily="Segoe UI" Margin="0,6,0,0">
                <Hyperlink NavigateUri="https://lolz.live/account/api"
                           RequestNavigate="Hyperlink_RequestNavigate" Foreground="#C0392B">
                  Получить: lolz.live/account/api
                </Hyperlink>
              </TextBlock>
            </StackPanel>
          </Border>

          <!-- Бинды -->
          <Border Background="#0E0A0A" CornerRadius="4" Padding="14,12" BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush Color="#1A0A0A"/></Border.BorderBrush>
            <StackPanel>
              <TextBlock Text="Бинды overlay" Foreground="#E0E0E0" FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold" Margin="0,0,0,3"/>
              <TextBlock Text="Insert — режим игры / окна     Delete — скрыть / показать"
                         Foreground="#444444" FontSize="10" FontFamily="Segoe UI" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="Lock / Unlock" Foreground="#555555" FontSize="10" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                  <Border BorderThickness="1" CornerRadius="3" Padding="1">
                    <Border.BorderBrush><SolidColorBrush Color="#2A1010"/></Border.BorderBrush>
                    <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
                    <TextBox x:Name="LockKeyBox" Background="Transparent" Foreground="#F0F0F0"
                             BorderThickness="0" Padding="8,6" FontSize="12"
                             FontFamily="Segoe UI" CaretBrush="#E74C3C"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Hide / Show" Foreground="#555555" FontSize="10" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                  <Border BorderThickness="1" CornerRadius="3" Padding="1">
                    <Border.BorderBrush><SolidColorBrush Color="#2A1010"/></Border.BorderBrush>
                    <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
                    <TextBox x:Name="HideKeyBox" Background="Transparent" Foreground="#F0F0F0"
                             BorderThickness="0" Padding="8,6" FontSize="12"
                             FontFamily="Segoe UI" CaretBrush="#E74C3C"/>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Margin="16,12,16,16">
          <Button Height="40" Cursor="Hand" Click="SaveBtn_Click" Margin="0,0,0,8">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="4">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#C0392B" Offset="0"/>
                      <GradientStop Color="#E74C3C" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <TextBlock Text="Сохранить настройки" Foreground="White"
                             FontSize="13" FontWeight="Bold" FontFamily="Segoe UI"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <Button Height="36" Cursor="Hand" Click="LogBtn_Click">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border CornerRadius="4" Background="#0E0A0A" BorderThickness="1">
                  <Border.BorderBrush><SolidColorBrush Color="#1A0A0A"/></Border.BorderBrush>
                  <TextBlock Text="Показать журнал" Foreground="#555555"
                             FontSize="12" FontFamily="Segoe UI"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#C0392B"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
