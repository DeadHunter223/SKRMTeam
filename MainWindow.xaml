<Window x:Class="SKRMTeam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SKRM Team" Height="620" Width="900"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Grid>
    <Border CornerRadius="6" Margin="10">
      <Border.Effect>
        <DropShadowEffect Color="#C0392B" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
      </Border.Effect>
      <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
    </Border>
    <Border CornerRadius="6" Margin="10" ClipToBounds="True" BorderThickness="1">
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#1A0808" Offset="0"/>
          <GradientStop Color="#C0392B" Offset="0.5"/>
          <GradientStop Color="#1A0808" Offset="1"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Background><SolidColorBrush Color="#0A0808"/></Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="2"/>
          <RowDefinition Height="68"/>
          <RowDefinition Height="28"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- TITLEBAR -->
        <Border Grid.Row="0" Background="#0E0A0A">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="3" Height="22" CornerRadius="2" Margin="0,0,12,0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF6B5B" Offset="0"/>
                    <GradientStop Color="#C0392B" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <TextBlock FontFamily="Segoe UI" VerticalAlignment="Center">
                <Run Text="SKRM" FontSize="16" FontWeight="Black" Foreground="#F0F0F0"/>
                <Run Text=" TEAM" FontSize="16" FontWeight="Light" Foreground="#333333"/>
              </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#111111" CornerRadius="3" Padding="12,5">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="GsiIndicator" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Ellipse.Fill><SolidColorBrush x:Name="GsiDotBrush" Color="#1E1010"/></Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="GsiStatusText" Text="Ожidaю CS2..."
                           Foreground="#333333" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Width="28" Height="28" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SettingsButton_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <TextBlock Text="&#x2699;" FontSize="13" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1A0A0A"/>
                        <Setter Property="Foreground" Value="#E74C3C"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button Width="28" Height="28" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <TextBlock Text="&#x2014;" FontSize="13" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#1A0A0A"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                      <TextBlock Text="&#x2715;" FontSize="12" Foreground="#444444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#C0392B"/>
                        <Setter Property="Foreground" Value="White"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Красная линия -->
        <Rectangle Grid.Row="1">
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#0A0808" Offset="0"/>
              <GradientStop Color="#E74C3C" Offset="0.25"/>
              <GradientStop Color="#C0392B" Offset="0.5"/>
              <GradientStop Color="#E74C3C" Offset="0.75"/>
              <GradientStop Color="#0A0808" Offset="1"/>
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>

        <!-- LOBBY INFO -->
        <Grid Grid.Row="2" Background="#0C0A0A" Margin="0,1,0,0">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock FontFamily="Segoe UI" Margin="0,0,0,4">
                <Run Text="LOBBY" FontSize="19" FontWeight="Black" Foreground="#F0F0F0"/>
                <Run Text=" CAPTURE" FontSize="19" FontWeight="Light" Foreground="#553333"/>
              </TextBlock>
              <TextBlock Text="Живой список игроков — обновляется в реальном времени"
                         FontSize="10" Foreground="#2A2A2A" FontFamily="Segoe UI"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="ТВОЙ STEAMID" FontSize="9" Foreground="#2A2A2A"
                         FontFamily="Segoe UI" HorizontalAlignment="Right" Margin="0,0,0,2"/>
              <TextBlock x:Name="OwnSteamIdText" Text="&#x2014;"
                         FontSize="12" Foreground="#E74C3C" FontFamily="Consolas"
                         FontWeight="Bold" HorizontalAlignment="Right"/>
              <Border Background="#111111" CornerRadius="3" Padding="10,3"
                      Margin="0,5,0,0" HorizontalAlignment="Right" BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#C0392B" Opacity="0.3"/></Border.BorderBrush>
                <StackPanel Orientation="Horizontal">
                  <Ellipse Width="5" Height="5" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Ellipse.Fill><SolidColorBrush x:Name="PlayerCountDot" Color="#1E1010"/></Ellipse.Fill>
                  </Ellipse>
                  <TextBlock Text="ИГРОКОВ  " Foreground="#333333" FontSize="10" FontFamily="Segoe UI" FontWeight="Bold"/>
                  <TextBlock x:Name="PlayerCountText" Text="0" Foreground="#E74C3C" FontSize="10" FontWeight="Black" FontFamily="Segoe UI"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ЗАГОЛОВКИ -->
        <Grid Grid.Row="3" Background="#090808" Margin="0,1,0,0">
          <Grid Margin="16,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="36"/>
              <ColumnDefinition Width="165"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="26"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="#" VerticalAlignment="Center" Foreground="#1E1010" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
            <TextBlock Grid.Column="2" Text="ИГРОК" VerticalAlignment="Center" Foreground="#1E1010" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
            <TextBlock Grid.Column="3" Text="STEAMID" VerticalAlignment="Center" Foreground="#1E1010" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
            <TextBlock Grid.Column="6" Text="СТОИМОСТЬ" VerticalAlignment="Center" Foreground="#E74C3C" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
            <TextBlock Grid.Column="7" Text="$100+" VerticalAlignment="Center" Foreground="#C0392B" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
            <TextBlock Grid.Column="8" Text="FACEIT" VerticalAlignment="Center" Foreground="#1E1010" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
          </Grid>
        </Grid>

        <!-- СПИСОК ИГРОКОВ -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Hidden" Margin="0,1,0,0">
          <ItemsControl x:Name="PlayersList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Height="42">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Красная полоска для богатых -->
                  <Border Grid.Column="0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsRich}" Value="True">
                            <Setter Property="Background">
                              <Setter.Value>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                  <GradientStop Color="#FF6B5B" Offset="0"/>
                                  <GradientStop Color="#C0392B" Offset="1"/>
                                </LinearGradientBrush>
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <!-- Строка -->
                  <Border Grid.Column="1" Padding="8,0" BorderThickness="0,0,0,1">
                    <Border.BorderBrush><SolidColorBrush Color="#110808"/></Border.BorderBrush>
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0F0808"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsRich}" Value="True">
                            <Setter Property="Background" Value="#0F0808"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid VerticalAlignment="Center">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="165"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Index}" Foreground="#222222" FontSize="11" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#E0E0E0" FontSize="13" FontFamily="Segoe UI" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding SteamId}" Foreground="#282828" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center"/>
                      <!-- Копировать -->
                      <Button Grid.Column="3" Tag="{Binding SteamId}" Click="CopySteamId_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Копировать SteamID">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <TextBlock Text="&#x29C9;" FontSize="13" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#222222"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                      <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                      <!-- Профиль -->
                      <Button Grid.Column="4" Tag="{Binding SteamProfileUrl}" Click="OpenProfile_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" ToolTip="Открыть Steam профиль">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <TextBlock Text="&#x2197;" FontSize="13" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="#222222"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                      <Setter Property="Foreground" Value="#60A5FA"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                      <!-- Стоимость -->
                      <TextBlock Grid.Column="5" Text="{Binding InventoryValue}" Foreground="{Binding ValueColor}" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                      <!-- RICH -->
                      <Border Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="2" Padding="6,2">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsRich}" Value="True">
                                <Setter Property="Background" Value="#1A0808"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#C0392B"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="Bold" FontFamily="Segoe UI">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value=""/>
                              <Setter Property="Foreground" Value="Transparent"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRich}" Value="True">
                                  <Setter Property="Text" Value="RICH"/>
                                  <Setter Property="Foreground" Value="#E74C3C"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                      <TextBlock Grid.Column="7" Text="{Binding FaceitStatus}" FontSize="10" FontFamily="Segoe UI" FontWeight="Bold" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#333333"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasFaceit}" Value="True">
                                <Setter Property="Foreground" Value="#FF6B00"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </Border>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- СТАТУСБАР -->
        <Border Grid.Row="5" Background="#090808" BorderThickness="0,1,0,0" Padding="16,0">
          <Border.BorderBrush><SolidColorBrush Color="#110808"/></Border.BorderBrush>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Text="Ожидаю CS2..." Foreground="#1A1010" FontSize="10" FontFamily="Segoe UI" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="DEL  hide / show" Background="Transparent" BorderThickness="0" Foreground="#1A1010" FontSize="10" Margin="0,0,14,0" Cursor="Hand" FontFamily="Segoe UI" Click="HideOverlay_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" VerticalAlignment="Center"/>
                </ControlTemplate>
              </Button.Template>
            </Button>
            <Button Grid.Column="2" Content="Сбросить сессию" Background="Transparent" BorderThickness="0" Foreground="#C0392B" FontSize="10" Cursor="Hand" FontFamily="Segoe UI" Click="ResetSession_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" VerticalAlignment="Center"/>
                </ControlTemplate>
              </Button.Template>
            </Button>
          </Grid>
        </Border>

      </Grid>
    </Border>
  </Grid>
</Window>
