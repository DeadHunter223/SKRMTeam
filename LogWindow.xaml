<Window x:Class="SKRMTeam.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Журнал" Height="400" Width="600"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#0F0F0F" CornerRadius="10" BorderBrush="#C0392B" BorderThickness="1">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="35"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TextBlock Text="Журнал событий" FontSize="14" FontWeight="Bold"
                           Foreground="White" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0" Foreground="#666"
                        FontSize="13" Cursor="Hand" Click="CloseBtn_Click"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" x:Name="LogScroll">
                <TextBox x:Name="LogBox" Background="Transparent" Foreground="#888"
                         BorderThickness="0" FontFamily="Consolas" FontSize="11"
                         IsReadOnly="True" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
